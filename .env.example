# ── AI APIs ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_OUTREACH_KEY=your_second_groq_key_here

# ── Scraping ─────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here

# ── AWS ──────────────────────────────────────────
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-south-1

# ── Server ───────────────────────────────────────
SERVER_DOMAIN=https://yourdomain.com
SERVER_PORT=5000

# ── WhatsApp (Evolution API) ─────────────────────
EVOLUTION_URL=http://localhost:8080
EVOLUTION_GLOBAL_KEY=your_evolution_global_api_key
EVOLUTION_API_KEY=your_evolution_instance_api_key
EVOLUTION_INSTANCE=ghost-worker
EVOLUTION_INSTANCE_PHONE=91XXXXXXXXXX

# ── Email (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_EMAIL=hello@yourdomain.com
SMTP_PASSWORD=your_email_password

# ── Agency Details ───────────────────────────────
AGENCY_NAME=Your Agency Name
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme_strong_password

# ── Flask ────────────────────────────────────────
FLASK_SECRET_KEY=generate_32_random_chars_here
LOG_LEVEL=INFO
